# NOAA Weather Day Analyzer - Secrets Configuration
#
# INSTRUCTIONS:
# 1. Copy this file to 'secrets.toml' (remove .template extension)
# 2. Replace the placeholder with your actual NOAA API key
# 3. NEVER commit secrets.toml to git!
#
# Use TOML: NOAA_API_KEY = "actual token". Whitespace around = is valid.
# Keep this template unchanged; enter the real token only in local or Cloud secrets.
#
# To get a free NOAA API key:
# 1. Visit: https://www.ncdc.noaa.gov/cdo-web/token
# 2. Enter your email address
# 3. Check your email for the token (arrives within minutes)
# 4. Copy the EXACT token - no extra spaces!

NOAA_API_KEY="paste-your-32-character-key-here"
